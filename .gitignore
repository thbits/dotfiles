k9s/.config/k9s/clusters/
k9s/.config/k9s/screen-dumps/
tmux/.config/tmux/plugins/
grafanactl/.config/grafanactl/config.yaml

# OpenCode runtime files and local secrets.
opencode/.config/opencode/node_modules/
opencode/.config/opencode/package.json
opencode/.config/opencode/package-lock.json
opencode/.config/opencode/bun.lock
opencode/.env

# claudecode: Claude Code writes runtime state into ~/.claude, so track only
# the config files and ignore everything else.
claudecode/.claude/**
!claudecode/.claude/
!claudecode/.claude/settings.json
!claudecode/.claude/CLAUDE.md
!claudecode/.claude/hooks/
!claudecode/.claude/hooks/*.sh
!claudecode/.claude/themes/
!claudecode/.claude/themes/*.json
!claudecode/.claude/agents/
!claudecode/.claude/agents/*.md
!claudecode/.claude/commands/
!claudecode/.claude/commands/*.md
!claudecode/.claude/skills/
!claudecode/.claude/skills/**

# naviclaude: track only config.yaml; the app writes its state next to it.
naviclaude/.config/naviclaude/*
!naviclaude/.config/naviclaude/config.yaml
